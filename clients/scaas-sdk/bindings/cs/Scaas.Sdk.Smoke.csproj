<!-- scaas-sdk plan T20c: the C# binding (spec §16.1), generated by uniffi-bindgen-cs into generated/ over the reference library
     with the async API (../lib.sh uniffi: ffi/target/lib-uniffi/), and its smoke test (`dotnet test`, gate `bind-cs`). The
     generated symbols are `internal`, so the smoke test compiles them into its own assembly. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- the test packages held by packages.lock.json (review B14); CI restores in locked mode -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- the generated code is the generator's: its warnings are not this project's -->
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625;CS8603;CS8600;CS8602;CS8604;CS0108;CS0114</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../ffi/target/lib-uniffi/libscaas_sdk_ffi.so" CopyToOutputDirectory="PreserveNewest" Link="libscaas_sdk_ffi.so" />
  </ItemGroup>
</Project>
