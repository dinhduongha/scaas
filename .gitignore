# Build output
target/
node_modules/
dist/
build/
pkg/
__pycache__/
*.py[cod]

# Secrets / local env
.env
.env.*
*.secret

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Tool state
.codegraph
.superpowers/
*.log

# Claude Code worktrees
.claude/*
!.claude/skills

# Local review notes and scratch (kept on disk, not versioned)
reviews/
scratchpad/

# local scratch notes and artifacts: kept across reboots, never committed (owner 2026-10-13)
/scratchpad/

# session hand-over notes: local only (owner 2026-11-02)
HANDOFF.md

# vendor/: the third-party sources, fetched at their pins and checked by scripts/vendor.sh (owner 2026-11-26,
# ARCH-POS-24); SCaaS's own files beside them (README.md, <name>.VENDORED.md, <name>.local/) stay tracked. Everything else
# is ignored, a package directory and the link `scripts/vendor.sh link` writes in its place alike (`/vendor/*/` matched
# no link)
/vendor/*
!/vendor/README.md
!/vendor/*.VENDORED.md
!/vendor/*.local/
