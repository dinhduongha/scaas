+                y := shr(72, mload(add(s, 0)))
+                y := or(shl(36, and(y, HI92)), and(y, M92))
+                y := or(shl(18, and(y, MUP)), and(y, MLO))
+                mstore(add(d, 0), add(mload(add(d, 0)), y))
+                y := shr(72, mload(add(s, 23)))
+                y := or(shl(36, and(y, HI92)), and(y, M92))
+                y := or(shl(18, and(y, MUP)), and(y, MLO))
+                mstore(add(d, 32), add(mload(add(d, 32)), y))
+                y := shr(72, mload(add(s, 46)))
+                y := or(shl(36, and(y, HI92)), and(y, M92))
+                y := or(shl(18, and(y, MUP)), and(y, MLO))
+                mstore(add(d, 64), add(mload(add(d, 64)), y))
+                y := shr(72, mload(add(s, 69)))
+                y := or(shl(36, and(y, HI92)), and(y, M92))
+                y := or(shl(18, and(y, MUP)), and(y, MLO))
