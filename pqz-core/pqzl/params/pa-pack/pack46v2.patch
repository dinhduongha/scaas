+                let x := shr(72, mload(add(p, mul(23, i))))
+                x := or(shl(36, and(x, HI92)), and(x, M92))
+                mstore(add(p, shl(5, i)), or(shl(18, and(x, MUP)), and(x, MLO)))
+            }
+        }
+    }
