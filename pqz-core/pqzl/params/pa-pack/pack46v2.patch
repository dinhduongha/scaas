+    // ------------------------------------------------------------------ spike PACK, layout P46 (measurement only)
+    // Stored ciphertexts (op blobs, `acc` slots) hold every coefficient in 46 bits (⌈log2 q⌉): one 64-bit-lane word (4
+    // coefficients) is 23 bytes, `x = c0 ‖ c1 ‖ c2 ‖ c3` big-endian, so the stream stays byte-aligned and `u`, `v`
+    // pack apart (2304 and 16 are multiples of 4). Memory, calldata and the statement keep the 64-bit lanes.
+
+    uint256 internal constant PKP = 13_248; // PK / 32 · 23
+    uint256 internal constant VP = 92;
+    uint256 internal constant CTP = 13_340;
+    uint256 internal constant ACC_WORDS = 417; // ⌈CTP / 32⌉ slots, each `not(stream word)`: never 0 for a canonical acc
+    uint256 private constant M46 = 0x3fffffffffff;
+    // the spread of a 184-bit record `c0 ‖ c1 ‖ c2 ‖ c3` into 64-bit lanes in two mask steps (c0|c1 up 36, then the
+    // upper field of each half up 18)
+    uint256 private constant HI92 = 0xfffffffffffffffffffffff00000000000000000000000;
+    uint256 private constant M92 = 0xfffffffffffffffffffffff;
+    uint256 private constant MUP = 0xfffffffffffc00000000000000000000fffffffffffc00000000000;
+    uint256 private constant MUP18 = 0x3fffffffffff000000000000000000003fffffffffff0000000000000000; // the inverse (pack)
+    uint256 private constant HI128 = 0xfffffffffffffffffffffff00000000000000000000000000000000;
+    uint256 private constant MLO = 0x3fffffffffff000000000000000000003fffffffffff;
+
+    /// @notice `dst[dOff ..] = pack(src)` (each 32-byte word of canonical lanes → 23 bytes); writes 9 zero bytes past
+    ///         the packed end, so callers write fields in ascending order and leave 9 bytes of slack.
+    function packCd(bytes memory dst, uint256 dOff, bytes calldata src) internal pure {
+        assembly ("memory-safe") {
+            let d := add(add(dst, 32), dOff)
+            let end := add(src.offset, src.length)
+            for { let p := src.offset } lt(p, end) { p := add(p, 32) } {
+                let w := calldataload(p)
+                w := or(shr(18, and(w, MUP18)), and(w, MLO))
+                mstore(d, shl(72, or(shr(36, and(w, HI128)), and(w, M92))))
+                d := add(d, 23)
+            }
+        }
+    }
+
+    /// @notice The packed form of a 64-bit-lane buffer (`src.length / 32 · 23` bytes; 32 bytes of slack allocated).
+    function packMem(bytes memory src) internal pure returns (bytes memory r) {
+        uint256 n = src.length / 32;
+        r = new bytes(n * 23 + 32);
+        assembly ("memory-safe") {
+            let s := add(src, 32)
+            let d := add(r, 32)
+            for { let i := 0 } lt(i, n) { i := add(i, 1) } {
+                let w := mload(add(s, shl(5, i)))
+                w := or(shr(18, and(w, MUP18)), and(w, MLO))
+                mstore(add(d, mul(23, i)), shl(72, or(shr(36, and(w, HI128)), and(w, M92))))
+            }
