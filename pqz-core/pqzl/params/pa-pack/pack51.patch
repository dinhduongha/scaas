diff -ruN base/test/research/PqzPackRoundTrip.t.sol p51/test/research/PqzPackRoundTrip.t.sol
--- base/test/research/PqzPackRoundTrip.t.sol	1970-01-01 08:00:00.000000000 +0800
+++ p51/test/research/PqzPackRoundTrip.t.sol	2026-10-21 15:28:17.377333252 +0700
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: LicenseRef-Vegan-Community-1.0
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+import {PqzCt} from "../../src/pqz/PqzCt.sol";
+
+/// Spike PACK (work tree only, `pack46.patch` / `pack51.patch`): the packed stored layout loses nothing — every
+/// canonical ciphertext packs to `CTP` bytes and unpacks to itself (random, all `q − 1`, all zero).
+contract PqzPackRoundTripTest is Test {
+    function _ct(uint256 seed, uint256 mode) internal pure returns (bytes memory c) {
+        c = new bytes(PqzCt.CT);
+        for (uint256 o; o < PqzCt.CT; o += 8) {
+            uint256 x = mode == 0 ? uint256(keccak256(abi.encode(seed, o))) % PqzCt.Q : mode == 1 ? PqzCt.Q - 1 : 0;
+            for (uint256 b; b < 8; ++b) c[o + b] = bytes1(uint8(x >> (8 * (7 - b))));
+        }
+    }
+
+    function _check(bytes memory c) internal pure {
+        bytes memory p = PqzCt.packCt(c);
+        assertEq(p.length, PqzCt.CTP, "packed length");
+        assertEq(keccak256(PqzCt.unpackCt(p)), keccak256(c), "round trip");
+    }
+
+    function test_roundTrip_random(uint256 seed) public pure {
+        _check(_ct(seed, 0));
+    }
+
+    function test_roundTrip_edges() public pure {
+        _check(_ct(0, 1));
+        _check(_ct(0, 2));
+    }
+}
