+    // ------------------------------------------------------------------ spike PACK, layout P51 (measurement only)
+    // Stored ciphertexts AND the token's working sums hold five coefficients per word in 51-bit lanes (the first
+    // coefficient in the top lane, bits 204..254; bit 255 free for `ACC_MARK`); `u` (2304 → 461 words, the last with
+    // four) and `v` (16 → 4 words, the last with one) pack apart. Lanes stay unreduced for ≤ 36 terms `≤ q` (36·q <
+    // 2^51): rollovers reduce every 32 entries. Only the statement (and the views) see 64-bit lanes (`unpackTo`).
+
+    uint256 internal constant UW = 461;
+    uint256 internal constant VW = 4;
+    uint256 internal constant PKP = 14_752; // UW · 32
+    uint256 internal constant VP = 128;
+    uint256 internal constant CTP = 14_880;
+    uint256 internal constant ACC_WORDS = 465;
+    uint256 private constant Q5 = 0x37bacbf0716906f7597e0e2d20deeb2fc1c5a41bdd65f838b4837bacbf07169; // q in each lane
+    uint256 private constant M51 = 0x7ffffffffffff;
+
+    /// @notice `dst[dOff ..] = pack(src)`: the `src.length / 8` coefficients of one segment (`u` or a `v`) in
+    ///         `⌈k / 5⌉` words.
+    function packCd(bytes memory dst, uint256 dOff, bytes calldata src) internal pure {
+        assembly ("memory-safe") {
+            let d := add(add(dst, 32), dOff)
+            let s := src.offset
+            let k := shr(3, src.length)
+            let full := div(k, 5)
+            for { let i := 0 } lt(i, full) { i := add(i, 1) } {
+                let p := add(s, mul(40, i))
+                mstore(d, or(or(or(shl(204, shr(192, calldataload(p))), shl(153, shr(192, calldataload(add(p, 8))))),
+                    or(shl(102, shr(192, calldataload(add(p, 16)))), shl(51, shr(192, calldataload(add(p, 24)))))),
+                    shr(192, calldataload(add(p, 32)))))
+                d := add(d, 32)
+            }
+            let r := mod(k, 5)
+            if r {
+                let p := add(s, mul(40, full))
+                let w := 0
+                for { let j := 0 } lt(j, r) { j := add(j, 1) } {
+                    w := or(w, shl(mul(51, sub(4, j)), shr(192, calldataload(add(p, shl(3, j))))))
+                }
+                mstore(d, w)
+            }
+        }
+    }
+
+    /// @notice One segment of `src.length / 8` coefficients (memory, 64-bit lanes) packed.
+    function packSeg(bytes memory src) internal pure returns (bytes memory r) {
+        uint256 k = src.length / 8;
+        r = new bytes(((k + 4) / 5) * 32);
+        assembly ("memory-safe") {
+            let s := add(src, 32)
+            let d := add(r, 32)
+            for { let i := 0 } lt(i, k) { i := add(i, 1) } {
+                let p := add(d, shl(5, div(i, 5)))
+                mstore(p, or(mload(p), shl(mul(51, sub(4, mod(i, 5))), shr(192, mload(add(s, shl(3, i)))))))
+            }
+        }
+    }
+
+    function packCt(bytes memory c) internal pure returns (bytes memory) {
+        bytes memory u = new bytes(PK);
+        bytes memory v = new bytes(V);
+        assembly ("memory-safe") {
+            mcopy(add(u, 32), add(c, 32), PK)
+            mcopy(add(v, 32), add(add(c, 32), PK), V)
+        }
+        return bytes.concat(packSeg(u), packSeg(v));
+    }
+
+    function packV(bytes memory v) internal pure returns (bytes memory) {
