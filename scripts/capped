#!/bin/bash
# Run a heavy command (cargo/forge/anvil/npm/odoo gate) in its own systemd
# scope capped at 4 GB, so systemd-oomd kills this command, not the terminal.
# ONE capped command at a time machine-wide (user cap after repeated OOM).
exec {fd}>"$HOME/.cache/r3-locks/heavy"
flock "$fd"
exec systemd-run --user --scope --quiet -p MemoryMax=4G -p MemorySwapMax=2G -- "$@"
