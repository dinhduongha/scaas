pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {UAKinds} from "../../../src/ua/UAKinds.sol";
import {UASafeVerifier, BlsMinSigBls12381Verifier} from "../../../src/ua/verifiers/PairingVerifiers.sol";
import {BlsMultiBls12381Verifier} from "../../../src/ua/verifiers/BlsMultiBls12381Verifier.sol";

/// Test hooks: a settable check gas (0 = the verifier's own) and the Fp negation.
contract BlsMultiHarness is BlsMultiBls12381Verifier {
    uint256 public cap;

    function setCap(uint256 c) external {
        cap = c;
    }

    function _checkGas(Mode mode) internal view override returns (uint256) {
        return cap == 0 ? super._checkGas(mode) : cap;
    }

    function neg(bytes memory buf, uint256 at) external pure returns (bytes memory) {
        _neg(buf, at);
        return buf;
    }
}

/// `BlsMultiBls12381Verifier` (spec 2026-11-19-bls12381-multi §4, §5; plan Task 6) against smartcontracts/vectors/ua/groups.json
/// `blsMulti` (generated by ua-rs, checked by clientkeys) and kinds.json's `0x0121` rows. UNAUDITED.
contract BlsMultiVerifierTest is Test {
    string internal constant GROUPS = "../vectors/ua/groups.json";
    string internal constant KINDS = "../vectors/ua/kinds.json";

    BlsMultiHarness internal v;
    BlsMinSigBls12381Verifier internal minsig;
    string internal j;

    function setUp() public {
        v = new BlsMultiHarness();
        minsig = new BlsMinSigBls12381Verifier();
        j = vm.readFile(GROUPS);
    }

    function _n(string memory arr) internal view returns (uint256 n) {
        while (vm.keyExistsJson(j, string.concat(".blsMulti.", arr, "[", vm.toString(n), "]"))) ++n;
    }

    function _at(string memory arr, uint256 i, string memory f) internal pure returns (string memory) {
        return string.concat(".blsMulti.", arr, "[", vm.toString(i), "].", f);
    }

    function _sigRow(string memory name) internal view returns (uint256) {
        uint256 n = _n("signatures");
        for (uint256 i; i < n; ++i) {
            if (keccak256(bytes(vm.parseJsonString(j, _at("signatures", i, "name")))) == keccak256(bytes(name))) {
                return i;
            }
        }
        revert(string.concat("no row ", name));
    }

    function _row(string memory name) internal view returns (bytes memory p, bytes32 m, bytes memory sig) {
        uint256 i = _sigRow(name);
        p = vm.parseJsonBytes(j, _at("signatures", i, "stored"));
        m = vm.parseJsonBytes32(j, _at("signatures", i, "uaMsg"));
        sig = vm.parseJsonBytes(j, _at("signatures", i, "signature"));
    }

    function _kindsRow(string memory prefix) internal view returns (uint256) {
        string memory k = vm.readFile(KINDS);
        for (uint256 i;; ++i) {
            string memory pfx = string.concat(".valid[", vm.toString(i), "]");
            if (vm.parseJsonUint(k, string.concat(pfx, ".kind")) != UAKinds.BLS12381_MULTI) continue;
            bytes memory label = bytes(vm.parseJsonString(k, string.concat(pfx, ".label")));
            bytes memory want = bytes(prefix);
            if (label.length < want.length) continue;
            bool same = true;
            for (uint256 b; b < want.length; ++b) {
                if (label[b] != want[b]) same = false;
            }
            if (same) return i;
        }
    }

    // ----- the vector rows -----

    /// Every signature row: `verify` as its `verify` column, `verifyMinimal` as its `minimal` column.
    function test_verify_rows() public view {
        uint256 n = _n("signatures");
        assertEq(n, 30);
        for (uint256 i; i < n; ++i) {
            bytes memory p = vm.parseJsonBytes(j, _at("signatures", i, "stored"));
            bytes32 m = vm.parseJsonBytes32(j, _at("signatures", i, "uaMsg"));
            bytes memory sig = vm.parseJsonBytes(j, _at("signatures", i, "signature"));
            assertEq(
                v.verify(p, m, sig),
                vm.parseJsonBool(j, _at("signatures", i, "verify")),
                vm.parseJsonString(j, _at("signatures", i, "name"))
            );
        }
    }

    function test_verifyMinimal_rows() public view {
        uint256 n = _n("signatures");
        uint256 surplus;
        for (uint256 i; i < n; ++i) {
            bytes memory p = vm.parseJsonBytes(j, _at("signatures", i, "stored"));
            bytes32 m = vm.parseJsonBytes32(j, _at("signatures", i, "uaMsg"));
            bytes memory sig = vm.parseJsonBytes(j, _at("signatures", i, "signature"));
            bool want = vm.parseJsonBool(j, _at("signatures", i, "minimal"));
            assertEq(v.verifyMinimal(p, m, sig), want, vm.parseJsonString(j, _at("signatures", i, "name")));
            if (vm.parseJsonBool(j, _at("signatures", i, "verify")) && !want) ++surplus;
        }
        assertGt(surplus, 0); // rows that verify and are not minimal: the two entries differ
    }

    /// Every PoP row (spec §4: positives at n = 2, 16, 32, 64; missing member, other threshold, parts under DST_MULTI_SIG,
    /// identity, the shared-message rogue key, split rogue (i), two rogues (ii)).
    function test_pop_rows() public view {
        uint256 n = _n("pop");
        assertEq(n, 11);
        for (uint256 i; i < n; ++i) {
            bytes memory d = vm.parseJsonBytes(j, _at("pop", i, "keyData"));
            bytes32 m = vm.parseJsonBytes32(j, _at("pop", i, "popMessage"));
            bytes memory pop = vm.parseJsonBytes(j, _at("pop", i, "pop"));
            assertEq(
                v.verifyPop(d, m, pop),
                vm.parseJsonBool(j, _at("pop", i, "valid")),
                vm.parseJsonString(j, _at("pop", i, "name"))
            );
        }
    }

    /// The PoP is never accepted by `verify` / `verifyMinimal` (the key data `d` is not the stored form), nor a signature by
    /// `verifyPop`.
    function test_popAndSignatureEntriesSeparate() public view {
        bytes memory d = vm.parseJsonBytes(j, _at("groups", 0, "keyData"));
        bytes memory p = vm.parseJsonBytes(j, _at("groups", 0, "stored"));
        bytes32 m = vm.parseJsonBytes32(j, _at("groups", 0, "popMessage"));
        bytes memory pop = vm.parseJsonBytes(j, _at("groups", 0, "pop"));
        assertTrue(v.verifyPop(d, m, pop));
        assertFalse(v.verifyPop(p, m, pop));
        assertFalse(v.verify(d, m, bytes.concat(pop, bytes32(uint256(3)))));
        assertFalse(v.verify(p, m, bytes.concat(pop, bytes32(uint256(3)))));
    }

    /// Review Focus 3: both sides of the pinned add / subtract boundary verify (n = 5: k = 3 adds, k = 4 subtracts; n = 64:
    /// k = 32 adds, k = 33 subtracts), and k = n takes the stored apk.
    function test_apkPathBoundary() public view {
        string[7] memory rows = [
            "n5t3 k = t",
            "n5t3 k = 4 (subtract path)",
            "n5t3 k = n",
            "n64t1 k = 32",
            "n64t1 k = 33",
            "n64t1 k = 1",
            "n64t1 k = 64"
        ];
        for (uint256 i; i < rows.length; ++i) {
            (bytes memory p, bytes32 m, bytes memory sig) = _row(rows[i]);
            assertTrue(v.verify(p, m, sig), rows[i]);
        }
    }

    /// R2-Q1: the verifier takes `ua` from `p`; one byte of the stored `ua` changed fails.
    function test_storedUaByteFlipped_fails() public view {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("n5t3 k = t");
        assertTrue(v.verify(p, m, sig));
        p[17] = bytes1(uint8(p[17]) ^ 1);
        assertFalse(v.verify(p, m, sig));
        assertFalse(v.verifyMinimal(p, m, sig));
    }

    /// One byte of a signing member's stored key changed fails (on the add path), and one byte of the stored `apk` on the all-n path.
    function test_storedKeyByteFlipped_fails() public view {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("n5t3 k = t");
        uint256 signers = uint256(bytes32(_slice(sig, 128, 32)));
        uint256 i = 1;
        while ((signers >> i) & 1 == 0) ++i; // a signer other than member 0
        uint256 o = 228 + 194 * i + 100; // inside its x
        p[o] = bytes1(uint8(p[o]) ^ 1);
        assertFalse(v.verify(p, m, sig));
        (p, m, sig) = _row("n5t3 k = n");
        assertTrue(v.verify(p, m, sig));
        p[32 + 100] = bytes1(uint8(p[32 + 100]) ^ 1); // inside apk
        assertFalse(v.verify(p, m, sig));
    }

    /// The gas `check` spends on the worst rows (n = 64: k = 32 the longest add path, k = 33 the longest subtract path with the
    /// negation; the PoP at n = 64) fits `CHECK_GAS` / `POP_GAS` (plan Task 9 measures them into the constants).
    function test_checkGas_worstRows() public {
        string[2] memory rows = ["n64t1 k = 32", "n64t1 k = 33"];
        uint256 worst;
        for (uint256 i; i < 2; ++i) {
            (bytes memory p, bytes32 m, bytes memory sig) = _row(rows[i]);
            uint256 g = gasleft();
            assertTrue(v.check(p, m, sig, UASafeVerifier.Mode.Verify), rows[i]);
            g -= gasleft();
            emit log_named_uint(rows[i], g);
            if (g > worst) worst = g;
        }
        assertLe(worst, v.CHECK_GAS());
        bytes memory d = vm.parseJsonBytes(j, _at("groups", 4, "keyData"));
        bytes32 pm = vm.parseJsonBytes32(j, _at("groups", 4, "popMessage"));
        bytes memory pop = vm.parseJsonBytes(j, _at("groups", 4, "pop"));
        uint256 gp = gasleft();
        assertTrue(v.check(d, pm, pop, UASafeVerifier.Mode.Pop));
        gp -= gasleft();
        emit log_named_uint("pop n64", gp);
        assertLe(gp, v.POP_GAS());
    }

    /// Spec §3: one 32-byte input fed to both verifiers. The weight-3 member's partial (a valid one-signer 0x0121 aggregate over
    /// `m = keccak256(ua ‖ ua_msg)`) does not verify as a `0x0106` signature by its key over `m`; that member's `0x0106` signature
    /// over the same `m` verifies as `0x0106` (positive control) and not as the 0x0121 aggregate.
    function test_dstsSeparate_sameInput() public view {
        (bytes memory p, bytes32 uaMsg, bytes memory part) = _row("w311t3 the weight-3 member alone");
        (,, bytes memory alone) = _row("w311t3 the weight-3 member's 0x0106 signature over the member message");
        bytes32 m = keccak256(abi.encodePacked(_slice(p, 0, 32), uaMsg));
        uint256 signers = uint256(bytes32(_slice(part, 128, 32)));
        uint256 i;
        while ((signers >> i) & 1 == 0) ++i;
        bytes memory pk = v_expand(_slice(p, 228 + 194 * i, 192));
        assertTrue(v.verify(p, uaMsg, part)); // the partial as a 0x0121 aggregate
        assertFalse(minsig.verify(pk, m, _slice(part, 0, 128))); // ... is not a 0x0106 signature over the same 32 bytes
        assertTrue(minsig.verify(pk, m, _slice(alone, 0, 128))); // the 0x0106 signature is one
        assertFalse(v.verify(p, uaMsg, alone)); // ... and not a 0x0121 aggregate
    }

    /// An out-of-gas inside `check` is `false`, not a revert: a valid row with the check capped below its need.
    function test_outOfGas_returnsFalse() public {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("n64t1 k = 32");
        assertTrue(v.verify(p, m, sig));
        v.setCap(60_000);
        assertFalse(v.verify(p, m, sig));
        bytes memory d = vm.parseJsonBytes(j, _at("pop", 0, "keyData"));
        bytes32 pm = vm.parseJsonBytes32(j, _at("pop", 0, "popMessage"));
        bytes memory pop = vm.parseJsonBytes(j, _at("pop", 0, "pop"));
        assertFalse(v.verifyPop(d, pm, pop));
        v.setCap(0);
        assertTrue(v.verifyPop(d, pm, pop));
    }

    /// A call that cannot give `check` its cap plus 1/64 reverts `UAVerifyGas` (a statement about the gas, never `false`).
    function test_belowCap_UAVerifyGas() public {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("n5t3 k = t");
        uint256 g = v.CHECK_GAS();
        vm.expectRevert(UAKinds.UAVerifyGas.selector);
        v.verify{gas: g}(p, m, sig);
        vm.expectRevert(UAKinds.UAVerifyGas.selector);
        v.verifyMinimal{gas: g}(p, m, sig);
        bytes memory d = vm.parseJsonBytes(j, _at("pop", 0, "keyData"));
        uint256 gp = v.POP_GAS(); // before `expectRevert`, which applies to the next call
        vm.expectRevert(UAKinds.UAVerifyGas.selector);
        v.verifyPop{gas: gp}(d, bytes32(0), new bytes(128));
        assertTrue(v.verify{gas: g + g / 63 + 20_000}(p, m, sig));
    }

    /// `σ = O` together with `apk(S) = O` would pair to 1: F12's group (keys `pk`, `−pk`, `pk_c`) with its threshold lowered to 2 in the
    /// stored bytes and σ at infinity, every pair of members signing; the cancelling pair has `apk(S) = O`. Every pair is refused
    /// (each of the two identity checks alone suffices; removing both accepts the cancelling pair).
    function test_identityPair_refused() public view {
        (bytes memory p, bytes32 m,) = _row("F12 documented: all bits, signed by pk_c alone");
        p[224] = 0;
        p[225] = 0x02; // t = 2
        uint8[3] memory pairs = [3, 5, 6];
        for (uint256 i; i < 3; ++i) {
            assertFalse(v.verify(p, m, bytes.concat(new bytes(128), bytes32(uint256(pairs[i])))));
        }
    }

    /// Review Focus 1: weights {65535, 65535}, t = 65535: one member authorises and is minimal; both authorise, not minimal.
    function test_weightSumWide() public view {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("w65535 one member (Review Focus 1)");
        assertTrue(v.verify(p, m, sig));
        assertTrue(v.verifyMinimal(p, m, sig));
        (p, m, sig) = _row("w65535 both (Review Focus 1)");
        assertTrue(v.verify(p, m, sig));
        assertFalse(v.verifyMinimal(p, m, sig));
    }

    /// R2-Q1's second condition: `d` at n = 48 and `p` at n = 64 are both 12,644 bytes; `verify` refuses that `d` and `verifyPop`
    /// that `p` on the length of their own form, before any precompile runs (the gas bound fails if the entry measured the
    /// other form and went on to hash and pair).
    function test_verify_refusesDAtN48() public view {
        string memory k = vm.readFile(KINDS);
        bytes memory d48 = vm.parseJsonBytes(k, string.concat(".valid[", vm.toString(_kindsRow("n48 t1")), "].keyData"));
        assertEq(d48.length, 12_644);
        (, bytes32 m, bytes memory sig) = _row("n64t1 k = 1");
        uint256 g = gasleft();
        assertFalse(v.verify(d48, m, sig));
        assertFalse(v.verifyMinimal(d48, m, sig));
        assertLt(g - gasleft(), 40_000, "refused on its length");
    }

    function test_verifyPop_refusesPAtN64() public view {
        bytes memory p64 = vm.parseJsonBytes(j, _at("groups", 4, "stored"));
        assertEq(p64.length, 12_644);
        bytes32 m = vm.parseJsonBytes32(j, _at("groups", 4, "popMessage"));
        bytes memory pop = vm.parseJsonBytes(j, _at("groups", 4, "pop"));
        uint256 g = gasleft();
        assertFalse(v.verifyPop(p64, m, pop));
        assertLt(g - gasleft(), 40_000, "refused on its length");
        assertTrue(v.verifyPop(vm.parseJsonBytes(j, _at("groups", 4, "keyData")), m, pop)); // positive control
    }

    /// N3: keys `pk`, `−pk`, `pk_c` … `pk_f` (n = 6, t = 4); everyone but the cancelling pair signs (k = 4, the subtract path; the
    /// non-signers sum to O, negated to O, added to apk) and verifies.
    function test_subtract_cancellingPair() public view {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("N3 non-signers sum to O (subtract path)");
        assertTrue(v.verify(p, m, sig));
        assertTrue(v.verifyMinimal(p, m, sig));
    }

    /// N3's unit row: `neg(x, y)` with one zero Fp component keeps it 0; the other becomes `p_381 − y_j`; O stays O.
    function test_negation_zeroComponent() public view {
        uint256 pHi = 0x1a0111ea397fe69a4b1ba7b6434bacd7;
        uint256 pLo = 0x64774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaab;
        bytes memory buf = new bytes(256);
        buf = bytes.concat(_slice(buf, 0, 192), bytes32(0), bytes32(uint256(5))); // y0 = 0, y1 = 5
        bytes memory out = v.neg(v.neg(buf, 128), 192);
        assertEq(_slice(out, 128, 64), new bytes(64)); // the zero component stays 0
        assertEq(uint256(bytes32(_slice(out, 192, 32))), pHi); // p − 5: no borrow out of the low word
        assertEq(uint256(bytes32(_slice(out, 224, 32))), pLo - 5);
        bytes memory borrow = bytes.concat(new bytes(192), bytes32(uint256(1)), bytes32(pLo + 1)); // low word above p's: a borrow
        out = v.neg(borrow, 192);
        assertEq(uint256(bytes32(_slice(out, 192, 32))), pHi - 2);
        assertEq(uint256(bytes32(_slice(out, 224, 32))), type(uint256).max);
        assertEq(v.neg(v.neg(new bytes(256), 128), 192), new bytes(256)); // O stays O
    }

    /// F12's documented row (spec §11 residual): keys `pk`, `−pk`, `pk_c`, t = 3, every bit set, σ by `pk_c` alone verifies.
    function test_f12_cancellingPair_documented() public view {
        (bytes memory p, bytes32 m, bytes memory sig) = _row("F12 documented: all bits, signed by pk_c alone");
        assertTrue(v.verify(p, m, sig));
    }

    // ----- helpers -----

    function v_expand(bytes memory c) internal pure returns (bytes memory out) {
        out = new bytes(256);
        for (uint256 l; l < 4; ++l) {
            for (uint256 b; b < 48; ++b) {
                out[l * 64 + 16 + b] = c[l * 48 + b];
            }
        }
    }

    function _slice(bytes memory b, uint256 o, uint256 n) internal pure returns (bytes memory out) {
        out = new bytes(n);
        for (uint256 i; i < n; ++i) {
            out[i] = b[o + i];
        }
    }
}
