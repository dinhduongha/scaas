pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {UAKinds} from "../../src/ua/UAKinds.sol";
import {PqUA} from "../../src/ua/PqUA.sol";

/// External wrapper so a revert of the library is observable with try/catch.
contract UAKindsHarness {
    function validate(uint16 kind, bytes memory keyData, bool hederaNative) external view {
        UAKinds.validateKeyData(kind, keyData, hederaNative);
    }
}

/// The Solidity identity layer against smartcontracts/vectors/ua/kinds.json and structures.json (generated by clientkeys
/// scripts/ua-vectors.mjs; the same files pin ua.js, scaas-ua, ua-py, ua-go and ua-cs).
contract UAKindsTest is Test {
    UAKindsHarness internal h;

    function setUp() public {
        h = new UAKindsHarness();
    }

    function _k() internal view returns (string memory) {
        return vm.readFile("../vectors/ua/kinds.json");
    }

    function _s() internal view returns (string memory) {
        return vm.readFile("../vectors/ua/structures.json");
    }

    function _p() internal view returns (string memory) {
        return vm.readFile("../vectors/ua/portable.json");
    }

    function _at(string memory arr, uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".", arr, "[", vm.toString(i), "].", field);
    }

    function _count(string memory json, string memory arr) internal view returns (uint256 n) {
        while (vm.keyExistsJson(json, string.concat(".", arr, "[", vm.toString(n), "]"))) ++n;
    }

    function test_kindTable() public view {
        string memory j = _k();
        uint256 n = _count(j, "kinds");
        assertEq(n, 31);
        for (uint256 i; i < n; ++i) {
            uint16 kind = uint16(vm.parseJsonUint(j, _at("kinds", i, "kind")));
            bool native = vm.parseJsonBool(j, _at("kinds", i, "native"));
            assertEq(UAKinds.name(kind), vm.parseJsonString(j, _at("kinds", i, "name")));
            assertEq(UAKinds.isNative(kind), native);
            assertEq(UAKinds.isSigning(kind), vm.parseJsonBool(j, _at("kinds", i, "signing")));
            assertEq(UAKinds.isZether(kind), vm.parseJsonBool(j, _at("kinds", i, "zether")));
            assertEq(UAKinds.isMember(kind, false), vm.parseJsonBool(j, _at("kinds", i, "member")));
            assertEq(UAKinds.isMember(kind, true), vm.parseJsonBool(j, _at("kinds", i, "memberHedera")));
            if (native) continue;
            assertEq(UAKinds.tag(kind), vm.parseJsonBytes32(j, _at("kinds", i, "TAG")));
            if (kind == UAKinds.MSIG) assertEq(bytes(UAKinds.groupName(kind)).length, 0);
            else assertEq(UAKinds.groupName(kind), vm.parseJsonString(j, _at("kinds", i, "group")));
        }
    }

    /// near-algorand T2 (spec §3.3, §4.3, §8): the two native kinds, 32-byte ids, no member kind; 0x0019 unknown.
    function test_nearAlgorandNatives() public {
        assertTrue(UAKinds.isNative(0x0017));
        assertTrue(UAKinds.isNative(0x0018));
        assertFalse(UAKinds.isNative(0x0019));
        assertEq(UAKinds.name(0x0017), "near-account");
        assertEq(UAKinds.name(0x0018), "algorand-address");
        assertFalse(UAKinds.isMember(0x0017, true));
        assertFalse(UAKinds.isMember(0x0018, true));
        assertFalse(UAKinds.isDerived(0x0017));
        vm.expectRevert(abi.encodeWithSelector(UAKinds.UAKindNotDerived.selector, uint16(0x0017)));
        h.validate(0x0017, new bytes(32), false);
        vm.expectRevert(abi.encodeWithSelector(UAKinds.UAKindNotDerived.selector, uint16(0x0018)));
        h.validate(0x0018, new bytes(32), false);
        vm.expectRevert(abi.encodeWithSelector(UAKinds.UAKindUnknown.selector, uint16(0x0019)));
        h.validate(0x0019, new bytes(32), false);
    }

    function test_groupsPurposesConstants() public view {
        string memory j = _k();
        uint256 ng = _count(j, "groups");
        for (uint256 i; i < ng; ++i) {
            assertEq(
                UAKinds.groupTag(vm.parseJsonString(j, _at("groups", i, "group"))),
                vm.parseJsonBytes32(j, _at("groups", i, "GROUP"))
            );
        }
        // every purpose at v1 (kem, pqz-key: UA-8), then pop v2 (UA-8 P1)
        bytes32[14] memory p = [
            UAKinds.PURPOSE_POP, UAKinds.PURPOSE_METATX, UAKinds.PURPOSE_METATX_CANCEL,
            UAKinds.PURPOSE_MEMBER, UAKinds.PURPOSE_ZETHER_AUTH, UAKinds.PURPOSE_ZETHER_OWNER, UAKinds.PURPOSE_KEYOP,
            UAKinds.PURPOSE_RECEIVER_FEE, UAKinds.PURPOSE_VP, UAKinds.PURPOSE_VC_ANCHOR, UAKinds.PURPOSE_TRADE,
            UAKinds.PURPOSE_KEM, UAKinds.PURPOSE_PQZ_KEY, UAKinds.PURPOSE_POP_V2
        ];
        assertEq(_count(j, "purposes"), 14);
        for (uint256 i; i < 14; ++i) assertEq(p[i], vm.parseJsonBytes32(j, _at("purposes", i, "purposeTag")));
        assertEq(UAKinds.MSG_TAG, vm.parseJsonBytes32(j, ".constants.MSG_TAG"));
        assertEq(UAKinds.PURPOSE_POP, vm.parseJsonBytes32(j, ".constants.POP_TAG"));
        assertEq(UAKinds.DOMAIN_TYPEHASH, vm.parseJsonBytes32(j, ".constants.DOMAIN_TYPEHASH"));
        assertEq(UAKinds.UAAUTH_TYPEHASH, vm.parseJsonBytes32(j, ".constants.UAAUTH_TYPEHASH"));
        assertEq(UAKinds.NAME_HASH, vm.parseJsonBytes32(j, ".constants.NAME_HASH"));
    }

    function test_validRows() public {
        vm.pauseGasMetering(); // a 220 KB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _k();
        uint256 n = _count(j, "valid");
        for (uint256 i; i < n; ++i) {
            uint16 kind = uint16(vm.parseJsonUint(j, _at("valid", i, "kind")));
            bytes memory d = vm.parseJsonBytes(j, _at("valid", i, "keyData"));
            h.validate(kind, d, vm.parseJsonBool(j, _at("valid", i, "hederaNative")));
            bytes32 ua = UAKinds.uaOf(kind, d);
            assertEq(UAKinds.name(kind), vm.parseJsonString(j, _at("valid", i, "name")));
            assertEq(ua, vm.parseJsonBytes32(j, _at("valid", i, "ua")), UAKinds.name(kind));
            assertFalse(UAKinds.inNativeSpace(ua));
            bytes32 want = kind == UAKinds.MSIG ? bytes32(0) : vm.parseJsonBytes32(j, _at("valid", i, "keyHash"));
            assertEq(UAKinds.keyHashOf(kind, d), want, UAKinds.name(kind));
        }
    }

    function test_invalidRows() public {
        vm.pauseGasMetering(); // a 220 KB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _k();
        uint256 n = _count(j, "invalid");
        assertGt(n, 100);
        for (uint256 i; i < n; ++i) {
            uint16 kind = uint16(vm.parseJsonUint(j, _at("invalid", i, "kind")));
            bytes memory d = vm.parseJsonBytes(j, _at("invalid", i, "keyData"));
            string memory reason = vm.parseJsonString(j, _at("invalid", i, "reason"));
            bytes memory want = abi.encodeWithSelector(_selector(vm.parseJsonString(j, _at("invalid", i, "error"))), kind);
            try h.validate(kind, d, vm.parseJsonBool(j, _at("invalid", i, "hederaNative"))) {
                revert(string.concat("accepted: ", reason));
            } catch (bytes memory got) {
                assertEq(got, want, reason);
            }
        }
    }

    function _selector(string memory err) internal pure returns (bytes4) {
        bytes32 e = keccak256(bytes(err));
        if (e == keccak256("UAKeyData")) return UAKinds.UAKeyData.selector;
        if (e == keccak256("UAKindUnknown")) return UAKinds.UAKindUnknown.selector;
        if (e == keccak256("UAKindNotDerived")) return UAKinds.UAKindNotDerived.selector;
        revert(string.concat("unexpected error code ", err));
    }

    function test_nativeSpaceAndMessages() public {
        vm.pauseGasMetering(); // a 220 KB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _k();
        uint256 nn = _count(j, "nativeSpace");
        for (uint256 i; i < nn; ++i) {
            assertEq(
                UAKinds.inNativeSpace(vm.parseJsonBytes32(j, _at("nativeSpace", i, "id"))),
                vm.parseJsonBool(j, _at("nativeSpace", i, "inNativeSpace"))
            );
        }
        uint256 nm = _count(j, "messages");
        for (uint256 i; i < nm; ++i) {
            uint16 kind = uint16(vm.parseJsonUint(j, _at("messages", i, "kind")));
            bytes32 got = UAKinds.uaMessage(
                kind, vm.parseJsonBytes32(j, _at("messages", i, "purposeTag")), vm.parseJsonBytes32(j, _at("messages", i, "digest"))
            );
            assertEq(got, vm.parseJsonBytes32(j, _at("messages", i, "uaMsg")));
        }
    }

    /// structures.json v3: the portable PoP rows (no chain context, UA-8 P1; typed records, typed-signing TS-D1), R_REG's
    /// message, the msig PQZ rows.
    function test_structures() public view {
        string memory s = _s();
        uint256 np = _count(s, "pop");
        assertEq(np, 7);
        for (uint256 i; i < np; ++i) {
            bytes32 ua = vm.parseJsonBytes32(s, _at("pop", i, "ua"));
            uint16 kind = uint16(vm.parseJsonUint(s, _at("pop", i, "kind")));
            bytes32 h = vm.parseJsonBytes32(s, _at("pop", i, "pqzKeyHash"));
            bytes32 kh = vm.parseJsonBytes32(s, _at("pop", i, "kemRecordHash"));
            assertEq(UAKinds.portableRecordDigest(ua, kind, h, kh), vm.parseJsonBytes32(s, _at("pop", i, "portableRecordDigest")));
            assertEq(
                UAKinds.registrationDigest(ua, kind, h, kh, vm.parseJsonBytes32(s, _at("pop", i, "pqzPopHash"))),
                vm.parseJsonBytes32(s, _at("pop", i, "registrationDigest"))
            );
        }
        uint256 nr = _count(s, "pqzReg");
        assertEq(nr, 3);
        for (uint256 i; i < nr; ++i) {
            bytes32 d = UAKinds.portableRecordDigest(
                vm.parseJsonBytes32(s, _at("pqzReg", i, "ua")),
                uint16(vm.parseJsonUint(s, _at("pqzReg", i, "kind"))),
                vm.parseJsonBytes32(s, _at("pqzReg", i, "pqzKeyHash")),
                vm.parseJsonBytes32(s, _at("pqzReg", i, "kemRecordHash"))
            );
            assertEq(d, vm.parseJsonBytes32(s, _at("pqzReg", i, "portableRecordDigest")));
            assertEq(
                UAKinds.uaMessage(UAKinds.PQZ_MLWE, UAKinds.PURPOSE_POP_V2, d),
                vm.parseJsonBytes32(s, _at("pqzReg", i, "pqzRegMessage"))
            );
        }
        bytes32 pqzH = vm.parseJsonBytes32(_k(), ".pqzKeyHash");
        uint256 nq = _count(s, "pqzMsig");
        for (uint256 i; i < nq; ++i) {
            bytes32 h = vm.parseJsonBool(s, _at("pqzMsig", i, "eligible")) ? pqzH : bytes32(0);
            bytes32 ua = vm.parseJsonBytes32(s, _at("pqzMsig", i, "ua"));
            assertEq(
                UAKinds.portableRecordDigest(ua, UAKinds.MSIG, h, UAKinds.kemRecordHash(ua, 0, "")),
                vm.parseJsonBytes32(s, _at("pqzMsig", i, "portableRecordDigest"))
            );
        }
        uint256 nu = _count(s, "uaAuth");
        for (uint256 i; i < nu; ++i) {
            string memory c = string.concat(".contexts.", vm.parseJsonString(s, _at("uaAuth", i, "context")));
            bytes32 sep = UAKinds.uaAuthDomainSeparator(
                vm.parseJsonUint(s, _at("uaAuth", i, "generation")),
                vm.parseJsonUint(s, string.concat(c, ".chainId")),
                vm.parseJsonAddress(s, string.concat(c, ".registry")),
                vm.parseJsonBytes32(s, string.concat(c, ".chainUid"))
            );
            assertEq(sep, vm.parseJsonBytes32(s, _at("uaAuth", i, "domainSeparator")));
            bytes32 got = UAKinds.uaAuthDigest(
                sep,
                vm.parseJsonBytes32(s, _at("uaAuth", i, "ua")),
                vm.parseJsonBytes32(s, _at("uaAuth", i, "purposeTag")),
                vm.parseJsonBytes32(s, _at("uaAuth", i, "digest"))
            );
            assertEq(got, vm.parseJsonBytes32(s, _at("uaAuth", i, "uaAuthDigest")));
        }
        uint256 nmem = _count(s, "member");
        for (uint256 i; i < nmem; ++i) {
            bytes32 m = UAKinds.memberDigest(
                vm.parseJsonBytes32(s, _at("member", i, "structureUa")), vm.parseJsonBytes32(s, _at("member", i, "uaMsg"))
            );
            assertEq(m, vm.parseJsonBytes32(s, _at("member", i, "memberDigest")));
        }
    }

    /// A valid key whose precompile call starts short of gas is "not enough gas", never a bad key (review I1).
    function test_gasShortIsNotKeyData() public {
        string memory j = _k();
        uint256 n = _count(j, "valid");
        bytes memory d;
        for (uint256 i; i < n && d.length == 0; ++i) {
            if (vm.parseJsonUint(j, _at("valid", i, "kind")) == UAKinds.BLS_BN254_MINSIG) {
                d = vm.parseJsonBytes(j, _at("valid", i, "keyData"));
            }
        }
        assertGt(d.length, 0);
        try h.validate{gas: 70_000}(UAKinds.BLS_BN254_MINSIG, d, false) {
            revert("accepted with 70k gas");
        } catch (bytes memory got) {
            assertEq(got, abi.encodeWithSelector(UAKinds.UAVerifyGas.selector));
        }
    }

    /// An invalid precompile key burns at most the cap of its call, not the caller's gas (review I1).
    function test_invalidPrecompileKeyGasBounded() public {
        string memory j = _k();
        uint256 n = _count(j, "invalid");
        uint256 checked;
        for (uint256 i; i < n; ++i) {
            uint16 kind = uint16(vm.parseJsonUint(j, _at("invalid", i, "kind")));
            if (kind != UAKinds.BLS12381_MINSIG && kind != UAKinds.BLS_BN254_MINSIG) continue;
            if (!_contains(vm.parseJsonString(j, _at("invalid", i, "reason")), "outside the subgroup")) continue;
            bytes memory d = vm.parseJsonBytes(j, _at("invalid", i, "keyData"));
            uint256 before = gasleft();
            try h.validate{gas: 5_000_000}(kind, d, false) {
                revert("accepted");
            } catch (bytes memory got) {
                assertEq(got, abi.encodeWithSelector(UAKinds.UAKeyData.selector, kind));
            }
            assertLt(before - gasleft(), 300_000);
            ++checked;
        }
        assertEq(checked, 2);
    }

    function _contains(string memory s, string memory sub) internal pure returns (bool) {
        bytes memory a = bytes(s);
        bytes memory b = bytes(sub);
        for (uint256 i; i + b.length <= a.length; ++i) {
            if (keccak256(_slice(a, i, b.length)) == keccak256(b)) return true;
        }
        return false;
    }

    function _slice(bytes memory a, uint256 start, uint256 len) internal pure returns (bytes memory out) {
        out = new bytes(len);
        for (uint256 i; i < len; ++i) out[i] = a[start + i];
    }

    /// P6a's PqUA keeps its own tags (ruling U8): they must equal the table's.
    function test_pqTagsMatchPqUA() public pure {
        for (uint16 k = UAKinds.MLDSA44; k <= UAKinds.SLHDSA128S; ++k) assertEq(UAKinds.tag(k), PqUA.tag(k));
    }

    // ----- UA-8 portable registrations (portable.json, generated by clientkeys scripts/ua-portable-vectors.mjs) -----

    function _row(string memory arr, uint256 i) internal pure returns (string memory) {
        return string.concat(".", arr, "[", vm.toString(i), "]");
    }

    /// `keyHash(0x0142, pqzKey)`, 0 without a key; a key has its set's length.
    function _pqzKeyHash(string memory j, string memory r, bytes memory pqzKey) internal view returns (bytes32) {
        if (pqzKey.length == 0) return 0;
        string memory set = vm.parseJsonString(j, string.concat(r, ".set"));
        assertEq(pqzKey.length, vm.parseJsonUint(j, string.concat(".sets.", set, ".pqzKeyLength")), set);
        return UAKinds.keyHashOf(UAKinds.PQZ_MLWE, pqzKey);
    }

    /// typed-signing TS-D1: the portable domain (name + version only) re-derived and pinned, equal to portable.json's.
    function test_portableDomainSeparatorPinned() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        bytes32 ds = keccak256(
            abi.encode(keccak256("EIP712Domain(string name,string version)"), keccak256("SCaaS UA Portable"), keccak256("1"))
        );
        assertEq(ds, 0x9a2c390d4dc940ccdb5fa6b21e673e87159bdd99aeef22ea791bcea9efc64ca1);
        assertEq(UAKinds.PORTABLE_DOMAIN_SEPARATOR, ds);
        assertEq(UAKinds.PORTABLE_DOMAIN_SEPARATOR, vm.parseJsonBytes32(_p(), ".typed.domainSeparator"));
    }

    /// typed-signing TS-D1: the five typehashes, from the exact type strings (pinned literals) and portable.json's.
    function test_portableTypehashesPinned() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _p();
        string[5] memory t = ["UAKemRecord", "UAPortableRecord", "UARegistration", "UAPqzKey", "UAPqzKeyRecord"];
        bytes32[5] memory got = [
            UAKinds.UA_KEM_RECORD_TYPEHASH, UAKinds.UA_PORTABLE_RECORD_TYPEHASH, UAKinds.UA_REGISTRATION_TYPEHASH,
            UAKinds.UA_PQZ_KEY_TYPEHASH, UAKinds.UA_PQZ_KEY_RECORD_TYPEHASH
        ];
        bytes32[5] memory pinned = [
            bytes32(0x0ab7989827627b89c268e88a0a0b06b62aefa70b0a466014931ca44acfa9a201),
            0x0c1553cfab3c35326558484df79963dced75ead85272d2a85985f264757bfe7f,
            0xc78b548ceb2fadf1f0a895f79f88b517327c120f0f9ab345f02981441048c87e,
            0x827d90728b100bc830d06b04dd2b9b5f7853adaa05502b4082875f881d925a00,
            0xaba20a80603724f71232573a76d2506ae38f60f39ea9cd8e71f4b64775dd7567
        ];
        for (uint256 i; i < 5; ++i) {
            string memory p = string.concat(".typed.types.", t[i]);
            assertEq(got[i], pinned[i], t[i]);
            assertEq(got[i], keccak256(bytes(vm.parseJsonString(j, string.concat(p, ".type")))), t[i]);
            assertEq(got[i], vm.parseJsonBytes32(j, string.concat(p, ".typehash")), t[i]);
        }
        assertEq(
            UAKinds.UA_REGISTRATION_TYPEHASH,
            keccak256(
                "UARegistration(UAPortableRecord record,bytes32 pqzPopHash)UAKemRecord(bytes32 ua,uint64 version,uint8 scheme,bytes32 kemPkHash)UAPortableRecord(bytes32 ua,uint16 kind,bytes32 pqzKeyHash,UAKemRecord kem)"
            )
        );
    }

    /// TS-D2: no KEM record is `UAKemRecord{ua, 0, 0, 0}` (never the word 0, and bound to the UA).
    function test_noKemRecordIsZeroRecord() public pure {
        bytes32 ua = keccak256("ua");
        bytes32 z = UAKinds.kemRecordHash(ua, 0, "");
        assertEq(z, keccak256(abi.encode(UAKinds.UA_KEM_RECORD_TYPEHASH, ua, uint256(0), uint256(0), bytes32(0))));
        assertTrue(z != 0);
        assertTrue(z != UAKinds.kemRecordHash(keccak256("other"), 0, ""));
    }

    /// Every `registrations[]` row (all four PQZ sets): the attribute hashes, `portableRecordDigest` and R_REG's message.
    function test_portableRecordDigestVectors() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _p();
        uint256 n = _count(j, "registrations");
        assertEq(n, 25);
        uint256 pqzRows;
        for (uint256 i; i < n; ++i) {
            string memory r = _row("registrations", i);
            string memory name_ = vm.parseJsonString(j, string.concat(r, ".name"));
            bytes32 ua = vm.parseJsonBytes32(j, string.concat(r, ".ua"));
            uint16 kind = uint16(vm.parseJsonUint(j, string.concat(r, ".kind")));
            assertEq(vm.parseJsonUint(j, string.concat(r, ".typedData.message.record.kind")), kind, name_);
            bytes32 h = _pqzKeyHash(j, r, vm.parseJsonBytes(j, string.concat(r, ".attrs.pqzKey")));
            assertEq(h, vm.parseJsonBytes32(j, string.concat(r, ".pqzKeyHash")), name_);
            bytes32 d = UAKinds.kemRecordHash(
                ua,
                uint64(vm.parseJsonUint(j, string.concat(r, ".attrs.kemVersion"))),
                vm.parseJsonBytes(j, string.concat(r, ".attrs.kemPk"))
            );
            assertEq(d, vm.parseJsonBytes32(j, string.concat(r, ".kemRecordHash")), name_);
            d = UAKinds.portableRecordDigest(ua, kind, h, d);
            assertEq(d, vm.parseJsonBytes32(j, string.concat(r, ".portableRecordDigest")), name_);
            d = h == 0 ? bytes32(0) : UAKinds.uaMessage(UAKinds.PQZ_MLWE, UAKinds.PURPOSE_POP_V2, d);
            assertEq(d, vm.parseJsonBytes32(j, string.concat(r, ".pqzRegMessage")), name_);
            if (h != 0) ++pqzRows;
        }
        assertEq(pqzRows, 8); // mldsa65 and msig-pq at each of the four sets
    }

    /// Every `registrations[]` row: `pqzPopHash = keccak256(pqzPop)`, the typed `registrationDigest` and the signed
    /// `popMessage` (`memberDigest` of it for an msig's derived members).
    function test_registrationDigestVectors() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _p();
        uint256 n = _count(j, "registrations");
        assertEq(n, 25);
        for (uint256 i; i < n; ++i) {
            string memory r = _row("registrations", i);
            string memory name_ = vm.parseJsonString(j, string.concat(r, ".name"));
            bytes32 ua = vm.parseJsonBytes32(j, string.concat(r, ".ua"));
            uint16 kind = uint16(vm.parseJsonUint(j, string.concat(r, ".kind")));
            bytes32 popHash = vm.parseJsonBytes32(j, string.concat(r, ".attrs.pqzPopHash"));
            bytes memory pqzPop = vm.parseJsonBytes(j, string.concat(r, ".pqzPop"));
            assertEq(pqzPop.length == 0 ? bytes32(0) : keccak256(pqzPop), popHash, name_);
            bytes32 record = UAKinds.portableRecordHash(
                ua, kind, vm.parseJsonBytes32(j, string.concat(r, ".pqzKeyHash")),
                vm.parseJsonBytes32(j, string.concat(r, ".kemRecordHash"))
            );
            bytes32 d = UAKinds.portableDigest(UAKinds.registrationHash(record, popHash));
            assertEq(d, vm.parseJsonBytes32(j, string.concat(r, ".registrationDigest")), name_);
            bytes32 m = UAKinds.uaMessage(kind, UAKinds.PURPOSE_POP_V2, d);
            assertEq(m, vm.parseJsonBytes32(j, string.concat(r, ".popMessage")), name_);
            if (kind == UAKinds.MSIG) {
                assertEq(UAKinds.memberDigest(ua, m), vm.parseJsonBytes32(j, string.concat(r, ".memberDigest")), name_);
            }
        }
    }

    /// Every `kemRecords[]` row: the `UAKemRecord` struct hash, its typed digest and the signed message (`memberDigest`
    /// of it for an msig).
    function test_kemRecordDigestVectors() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _p();
        uint256 n = _count(j, "kemRecords");
        assertEq(n, 9);
        for (uint256 i; i < n; ++i) {
            string memory r = _row("kemRecords", i);
            string memory id = vm.parseJsonString(j, string.concat(r, ".id"));
            bytes32 ua = vm.parseJsonBytes32(j, string.concat(r, ".ua"));
            bytes memory pk = vm.parseJsonBytes(j, string.concat(r, ".kemPk"));
            assertEq(pk.length, UAKinds.KEM_PK_LENGTH, id);
            uint64 v = uint64(vm.parseJsonUint(j, string.concat(r, ".version")));
            assertEq(UAKinds.kemRecordHash(ua, v, pk), vm.parseJsonBytes32(j, string.concat(r, ".structHash")), id);
            bytes32 d = UAKinds.kemRecordDigest(ua, v, pk);
            assertEq(d, vm.parseJsonBytes32(j, string.concat(r, ".digest")), id);
            uint16 kind = uint16(vm.parseJsonUint(j, string.concat(r, ".kind")));
            bytes32 m = UAKinds.uaMessage(kind, UAKinds.PURPOSE_KEM, d);
            assertEq(m, vm.parseJsonBytes32(j, string.concat(r, ".message")), id);
            if (kind == UAKinds.MSIG) {
                assertEq(UAKinds.memberDigest(ua, m), vm.parseJsonBytes32(j, string.concat(r, ".memberDigest")), id);
            }
        }
    }

    /// Every `pqzKeyRecords[]` row (`setPqzKey`, all four sets): the typed `UAPqzKey` and `UAPqzKeyRecord` digests, the
    /// signed message and the later key's R_REG message.
    function test_pqzKeyRecordDigestVectors() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _p();
        uint256 n = _count(j, "pqzKeyRecords");
        assertEq(n, 8);
        for (uint256 i; i < n; ++i) {
            string memory r = _row("pqzKeyRecords", i);
            string memory name_ = vm.parseJsonString(j, string.concat(r, ".name"));
            bytes32 ua = vm.parseJsonBytes32(j, string.concat(r, ".ua"));
            bytes32 h = _pqzKeyHash(j, r, vm.parseJsonBytes(j, string.concat(r, ".pqzKey")));
            assertEq(h, vm.parseJsonBytes32(j, string.concat(r, ".pqzKeyHash")), name_);
            bytes32 kd = UAKinds.pqzKeyDigest(ua, h);
            assertEq(kd, vm.parseJsonBytes32(j, string.concat(r, ".pqzKeyDigest")), name_);
            bytes32 ph = vm.parseJsonBytes32(j, string.concat(r, ".pqzPopHash"));
            bytes32 rd = UAKinds.pqzKeyRecordDigest(ua, h, ph);
            assertEq(rd, UAKinds.portableDigest(UAKinds.pqzKeyRecordHash(UAKinds.pqzKeyHash_(ua, h), ph)), name_);
            assertEq(rd, vm.parseJsonBytes32(j, string.concat(r, ".recordDigest")), name_);
            uint16 kind = uint16(vm.parseJsonUint(j, string.concat(r, ".kind")));
            bytes32 m = UAKinds.uaMessage(kind, UAKinds.PURPOSE_PQZ_KEY, rd);
            assertEq(m, vm.parseJsonBytes32(j, string.concat(r, ".message")), name_);
            assertEq(UAKinds.uaMessage(UAKinds.PQZ_MLWE, UAKinds.PURPOSE_PQZ_KEY, kd),
                vm.parseJsonBytes32(j, string.concat(r, ".pqzRegMessage")), name_);
            if (kind == UAKinds.MSIG) {
                assertEq(UAKinds.memberDigest(ua, m), vm.parseJsonBytes32(j, string.concat(r, ".memberDigest")), name_);
            }
        }
    }

    /// portable.json `tags` (and kinds.json's v2 / UA-8 purpose rows, in test_groupsPurposesConstants); the record tags
    /// of the raw digests are gone (typed-signing TS-D3: legacy/typed-signing/UAKindsPortableRaw.sol).
    function test_purposeTagsV2() public {
        vm.pauseGasMetering(); // a 2.5 MB JSON string per cheatcode call; correctness test, not a gas test
        string memory j = _p();
        assertEq(UAKinds.PURPOSE_POP_V2, vm.parseJsonBytes32(j, ".tags.PURPOSE_POP_V2.hash"));
        assertEq(UAKinds.PURPOSE_KEM, vm.parseJsonBytes32(j, ".tags.PURPOSE_KEM.hash"));
        assertEq(UAKinds.PURPOSE_PQZ_KEY, vm.parseJsonBytes32(j, ".tags.PURPOSE_PQZ_KEY.hash"));
        assertFalse(vm.keyExistsJson(j, ".tags.KEM_RECORD_TAG"));
        assertFalse(vm.keyExistsJson(j, ".tags.PQZ_KEY_RECORD_TAG"));
        assertEq(UAKinds.groupTag(UAKinds.groupName(UAKinds.PQZ_MLWE)), vm.parseJsonBytes32(j, ".tags.PQZ_KEY_GROUP.hash"));
    }

