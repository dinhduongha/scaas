pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {IFactoryToken} from "../../src/factory/IFactoryToken.sol";
import {ChainEnvCode} from "../../src/factory/ChainEnvCode.sol";
import {Create3} from "../../src/factory/Create3.sol";

/// Chain-neutral spec §6.4 (Fable P2-5; plan T74): `smartcontracts/vectors/factory/create3_kat.json` pins the CREATE3 proxy
/// init code, the clone-with-env init code, the `ChainEnv` code layout (a plain, a PQZ, a Zether and a `PqChat` env, byte
/// for byte) and the address derivation `(factory, creatorId, contractClass, kind, salt) -> (s, proxy, instance)` with a
/// native and a derived creator, classes 1, 2, 3, non-zero salts. Read here, by `clientkeys` (`test/create3.test.js`) and by
/// `ua-rs` (on its branch). `WRITE_CREATE3_KAT=true forge test --match-path test/v2/Create3Kat.t.sol` rewrites it from the
/// contracts' own libraries. **UNAUDITED.**
contract Create3KatTest is Test {
    string constant OUT = "../vectors/factory/create3_kat.json";
    address constant FACTORY = 0x5caA5CAa5Caa5caa5cAa5CAa5caa5caa5caa5CAa; // any address: the formula's input
    address constant IMPL = 0x1111111111111111111111111111111111111111;
    bytes32 constant UID = 0x24e43dcbfc9624b23bf89409acd104d6e5671e2c41d8c192373d65519321c464;

    function _envs() internal pure returns (string[4] memory names, IFactoryToken.ChainEnv[4] memory es) {
        names = ["plain", "pqz", "zether", "pqchat"];
        for (uint256 i; i < 4; ++i) {
            es[i].chainUid = UID;
            es[i].registry = 0x2222222222222222222222222222222222222222;
            es[i].govRouter = 0x3333333333333333333333333333333333333333;
        }
        es[0].smartKeyAccountImpl = 0x4444444444444444444444444444444444444444;
        es[1].deps = new address[](1);
        es[1].deps[0] = 0x5555555555555555555555555555555555555555;
        es[2].deps = new address[](4);
        (es[2].deps[0], es[2].deps[1], es[2].deps[2], es[2].deps[3]) = (0x6666666666666666666666666666666666666666,
            0x7777777777777777777777777777777777777777, 0x8888888888888888888888888888888888888888,
            0x9999999999999999999999999999999999999999);
        es[3].params = new bytes32[](1);
        es[3].params[0] = bytes32(uint256(131_072));
    }

    function _rows() internal pure returns (bytes32[6] memory creators, uint16[6] memory classes, uint16[6] memory kinds,
        bytes32[6] memory salts)
    {
        bytes32 native = bytes32(uint256(0xA11C)); // a native id: a 20-byte address, zero-padded
        bytes32 derived = 0xcafe00000000000000000000000000000000000000000000000000000000a11a;
        creators = [native, derived, native, derived, native, native];
        classes = [uint16(1), 1, 2, 2, 3, 1];
        kinds = [uint16(0), 13, 0, 0, 0, 5];
        salts = [bytes32("s"), bytes32("s"), bytes32("dex"), bytes32(uint256(7)), bytes32("chat"), keccak256("x")];
    }

    function _json() internal pure returns (string memory j) {
        j = string.concat('{"_comment": "chain-neutral spec 6.4: the CREATE3 proxy, the clone-with-env init code, the ChainEnv',
            ' code layout, the address derivation. Generated by test/v2/Create3Kat.t.sol (WRITE_CREATE3_KAT=true); UNAUDITED",\n',
            '"proxyInitCode": "', vm.toString(Create3.PROXY_INITCODE), '",\n"proxyInitCodeHash": "',
            vm.toString(Create3.PROXY_INITCODE_HASH), '",\n"proxyRuntime": "0x363d3d37363d34f0",\n',
            '"cloneInitPrefix": "0x61<2-byte runtime length>3d81600a3d39f3",\n',
            '"implementation": "', vm.toString(IMPL), '",\n"envs": [\n');
        (string[4] memory names, IFactoryToken.ChainEnv[4] memory es) = _envs();
        for (uint256 i; i < 4; ++i) {
            bytes memory env = ChainEnvCode.encode(es[i]);
            bytes memory init = ChainEnvCode.initCode(IMPL, env);
            j = string.concat(j, '  {"name": "', names[i], '", "env": "', vm.toString(env), '", "envLength": ',
                vm.toString(env.length), ', "cloneInitCode": "', vm.toString(init), '", "cloneRuntimeHash": "',
                vm.toString(keccak256(abi.encodePacked(hex"363d3d373d3d3d363d73", IMPL, hex"5af43d82803e903d91602b57fd5bf3", env))),
                '"}', i < 3 ? ",\n" : "\n");
        }
        j = string.concat(j, '],\n"factory": "', vm.toString(FACTORY), '",\n"rows": [\n');
        (bytes32[6] memory c, uint16[6] memory cl, uint16[6] memory k, bytes32[6] memory sa) = _rows();
        for (uint256 i; i < 6; ++i) {
            bytes32 s = keccak256(abi.encode(c[i], cl[i], k[i], sa[i]));
            address proxy = Create3.proxyOf(FACTORY, s);
            j = string.concat(j, '  {"creatorId": "', vm.toString(c[i]), '", "contractClass": ', vm.toString(cl[i]),
                ', "kind": ', vm.toString(k[i]), ', "salt": "', vm.toString(sa[i]), '", "s": "', vm.toString(s),
                '", "proxy": "', vm.toString(proxy), '", "instance": "', vm.toString(Create3.instanceOf(proxy)), '"}',
                i < 5 ? ",\n" : "\n");
        }
        j = string.concat(j, "]}\n");
    }

    function test_create3Kat() public {
        string memory j = _json();
        if (vm.envOr("WRITE_CREATE3_KAT", false)) {
            vm.writeFile(OUT, j);
            return;
        }
        assertEq(vm.readFile(OUT), j, "create3_kat.json is stale: WRITE_CREATE3_KAT=true forge test --match-path test/v2/Create3Kat.t.sol");
    }

    /// The rows against an independent formula (keccak256 by hand), so the vector cannot drift with the library.
    function test_rowsByHand() public pure {
        (bytes32[6] memory c, uint16[6] memory cl, uint16[6] memory k, bytes32[6] memory sa) = _rows();
        for (uint256 i; i < 6; ++i) {
            bytes32 s = keccak256(abi.encode(c[i], cl[i], k[i], sa[i]));
            address proxy = address(uint160(uint256(keccak256(abi.encodePacked(bytes1(0xff), FACTORY, s,
                keccak256(hex"67363d3d37363d34f03d5260086018f3"))))));
            assertEq(Create3.addressOf(FACTORY, s), address(uint160(uint256(keccak256(abi.encodePacked(hex"d694", proxy,
                hex"01"))))));
        }
    }
}
